msgid "plugins.themes.smwimmersion.name"
msgstr "SMW Theme"

msgid "plugins.themes.smwimmersion.description"
msgstr "An OJS theme developed by the journal Swiss Medical Weekly, based on Immersion. Requires the Immersion theme to be installed; otherwise this theme will not load its styles, templates or hooks."

msgid "plugins.themes.smwimmersion.parentMissing"
msgstr "The SMW Theme requires the Immersion theme to be installed. Install Immersion before activating SMW Theme; otherwise its styles and templates will not load."

