msgid "plugins.themes.smwimmersion.name"
msgstr "SMW Theme"

msgid "plugins.themes.smwimmersion.description"
msgstr "由期刊《瑞士医学周刊》（Swiss Medical Weekly）开发的 OJS 主题，基于 Immersion。 需要先安装 Immersion 主题；否则此主题将不会加载其样式、模板或钩子。"

