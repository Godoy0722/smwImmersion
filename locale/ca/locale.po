msgid "plugins.themes.smwimmersion.name"
msgstr "SMW Theme"

msgid "plugins.themes.smwimmersion.description"
msgstr "Un tema d'OJS desenvolupat per la revista Swiss Medical Weekly, basat en Immersion. Requereix que el tema Immersion estigui instal·lat; en cas contrari, aquest tema no carregarà els seus estils, plantilles ni hooks."

msgid "plugins.themes.smwimmersion.parentMissing"
msgstr "El tema SMW requereix que el tema Immersion estigui instal·lat. Instal·leu Immersion abans d'activar el tema SMW; en cas contrari, els seus estils i plantilles no es carregaran."

msgid "plugins.themes.smwimmersion.colorPick"
msgstr "Selector de color"

msgid "plugins.themes.smwimmersion.colorPickInstructions"
msgstr "Trieu un color per a una secció que es mostrarà al front-end de la revista. Ha de ser un codi HTML hex vàlid (p. ex. #ffff00 per al groc)."

