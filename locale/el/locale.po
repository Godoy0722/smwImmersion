msgstr "Επιλογέας χρώματος"

msgid "plugins.themes.smwimmersion.colorPickInstructions"
msgstr "Επιλέξτε ένα χρώμα για μια ενότητα που θα εμφανίζεται στο frontend του περιοδικού. Πρέπει να είναι έγκυρος δεκαεξαδικός κώδικας HTML (π.χ. #ffff00 για κίτρινο)."

