msgid "plugins.themes.smwimmersion.name"
msgstr "SMW Theme"

msgid "plugins.themes.smwimmersion.description"
msgstr "Um tema OJS desenvolvido pela revista Swiss Medical Weekly, baseado no Immersion. Requer que o tema Immersion esteja instalado; caso contrário, este tema não carregará os seus estilos, modelos ou hooks."

msgid "plugins.themes.smwimmersion.parentMissing"
msgstr "O tema SMW requer que o tema Immersion esteja instalado. Instale o Immersion antes de ativar o tema SMW; caso contrário, os seus estilos e modelos não serão carregados."

msgid "plugins.themes.smwimmersion.colorPick"
msgstr "Seletor de cor"

msgid "plugins.themes.smwimmersion.colorPickInstructions"
msgstr "Escolha uma cor para uma secção a exibir no front-end da revista. Deve ser um código HTML hex válido (ex. #ffff00 para amarelo)."

